rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {
      allow create: if request.auth != null
        && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.keys().hasAll(['hostUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['hostUid', 'createdAt'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow get: if request.auth != null && resource.data.hostUid == request.auth.uid;

      match /members/{uid} {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/rooms/$(code))
          && request.resource.data.keys().hasOnly(['joinedAt'])
          && request.resource.data.joinedAt == request.time;
      }
    }
  }
}
